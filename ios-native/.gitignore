# Xcode-generated project files.
#
# project.yml is the source of truth — xcodegen creates the .xcodeproj
# locally for each dev. Committing the .xcodeproj means every build-
# settings tweak collides in git, so we ignore it.

BuilderHQ.xcodeproj/

# Info.plist + entitlements are AUTO-GENERATED by xcodegen from the
# `info.properties` and `entitlements.properties` blocks in
# project.yml. Don't commit — xcodegen rewrites them on every
# generate. If you need to change something inside, edit project.yml
# instead.
BuilderHQ/Info.plist
BuilderHQ/BuilderHQ.entitlements

# Xcode user state
xcuserdata/
*.xcuserstate

# Build artifacts
build/
DerivedData/
*.ipa
*.dSYM.zip
*.xcarchive

# CocoaPods (if we add it later)
Pods/

# Swift Package Manager
.build/
.swiftpm/

# Misc
.DS_Store
