# BuilderHQ — environment variables
# Copy this to .env.local and fill in real values for your dev environment.
# Never commit .env.local. Production values live in Vercel's env UI.

# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Auth (Auth.js v5) ──────────────────────────────────────────────────
# generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth (optional, Phase 1)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Database (Neon Postgres + Drizzle) ─────────────────────────────────
DATABASE_URL=""
# Direct (non-pooled) URL for migrations
DATABASE_URL_UNPOOLED=""

# ─── Storage (Cloudflare R2, S3-compatible) ─────────────────────────────
# All four below are required from Phase 2 step 2 (document uploads).
# Generate the API token in Cloudflare → R2 → Manage API Tokens. Choose
# Account API token (not User), permission "Object Read & Write", and
# scope it to the single bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="builderhq-documents"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# Optional — only set when a custom CDN domain is wired up.
R2_PUBLIC_URL=""

# ─── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="BuilderHQ <noreply@builderhq.com.au>"
# Dev-only safety belt — comma-separated emails that may receive real
# mail when NODE_ENV != "production". Every other recipient is silently
# suppressed (logged + no actual send). Stops a local test "publish
# project" from emailing every real builder in your Neon dev branch.
# Leave blank in production builds (it's ignored there anyway).
EMAIL_DEV_ALLOWLIST=""

# ─── AI extraction (Anthropic / Claude) ────────────────────────────────
# Powers "scan a quote / plans to autofill". Optional — without it the
# extraction endpoints return 503 and the manual forms still work.
# Use a zero-data-retention key (customer docs are sent to Claude).
ANTHROPIC_API_KEY=""

# ─── Payments (Stripe) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Jobs (Inngest) ─────────────────────────────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Observability ──────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Source-map upload (CI / Vercel only — local builds skip silently).
# Get these from Sentry → Settings → Auth Tokens (org scope + project scope).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Meta (Facebook) Pixel. Set in Vercel's PRODUCTION scope only: leaving it
# empty in development and on previews is what keeps test browsing out of
# the live ad account. Mounted on the marketing and auth surfaces only,
# never inside the signed-in application (see the privacy policy).
NEXT_PUBLIC_META_PIXEL_ID=""

# Meta Conversions API (server-side events). NO NEXT_PUBLIC_ prefix: the
# token sends events as you, so it must stay out of the browser bundle.
# META_DATASET_ID is usually the same number as the pixel id above, since
# Meta renamed Pixels to Datasets. It is what deduplicates the browser
# event against the server event, so neither is counted twice.
META_CAPI_ACCESS_TOKEN=""
META_DATASET_ID=""

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ─── Rate limiting (Upstash Redis, free tier 10k cmd/day) ───────────────
# Create a free Redis DB at https://upstash.com → copy the REST URL +
# REST token. When both are empty, lib/ratelimit.ts no-ops cleanly so
# local dev still works. In production, leaving these unset means
# every auth endpoint is unprotected — set them before going live.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Push (deferred — OneSignal, web + RN) ──────────────────────────────
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""

# ─── Verification (deferred — ABR / VBA) ────────────────────────────────
ABR_GUID=""
