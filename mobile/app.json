{
  "expo": {
    "name": "BuilderHQ",
    "slug": "builderhq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "builderhq",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#03090f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.builderhq.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.builderhq.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#03090f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": ["NOTIFICATIONS", "VIBRATE"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#03090f",
          "dark": { "backgroundColor": "#03090f" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://builderhq.com.au"
    }
  }
}
